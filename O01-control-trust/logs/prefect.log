# Monitoring extras
email = ["prefect-email>=0.4.0"]
slack = ["prefect-slack>=0.3.0"]

[project.scripts]
prefect = "prefect.cli:app"

[project.entry-points."mkdocs.plugins"]
render_swagger = "prefect.utilities.render_swagger:SwaggerPlugin"

[dependency-groups]
dev = [
    "cairosvg>=2.7.1; python_version<'3.14'",
    "codespell>=2.2.6",
    "ipython",
    "jinja2>=3.1.6",
    "moto>=5",
    "numpy",
    "pendulum[test]>=3.1.0,<4; python_version<'3.13'",
    "pillow>=11.1.0; python_version<'3.14'",
    "pre-commit>=4.1.0",
    "pluggy>=1.5.0",
    "pyright>=1.1.390",
    # Keep Python 3.10 on pytest 8. Upgrading 3.10 to pytest 9 forces a newer
    # pytest-asyncio line, and pytest-asyncio >=1.1 pulls in
    # backports-asyncio-runner on Python <3.11. That replaces C-accelerated
    # asyncio.Task with a pure-Python implementation and slows our async-heavy
    # test suite enough to hit CI timeouts. Remove this split when we drop
    # Python 3.10 support.
    "pytest>=9,<10; python_version >= '3.11'",
    "pytest>=8.4.2,<9; python_version < '3.11'",
    "pytest-asyncio>=1.1,<1.5; python_version >= '3.11'",
    "pytest-asyncio>=0.21,<1.1; python_version < '3.11'",
    "pytest-cov>=6.0",
    "pytest-env>=1.1.5",
    "pytest-flakefinder>=1.1.0",
    "typsht>=0.0.1a4",
    "pytest-timeout>=2.3.1",
    "pytest-xdist>=3.6.1",
    "pyyaml>=6.0.1",
    "redis>=5.2.1",
    "setuptools>=65.6.3",
    "uv>=0.5.30",
    "vale>=3.9.5",
    "virtualenv>=20.29.2",
    "watchfiles>=1.0.4",
    "yamllint>=1.35.1",
    "respx>=0.22.0",
    "codespell==2.4.2",
    "ruff==0.15.20",
    "mypy==1.19.1",
    "types-cachetools>=5.3.1",
    "types-PyYAML>=6.0.12",
    "types-dateparser>=1.2.0",
    "mkdocs>=1.6.1",
    "mkdocs-material>=9.6.4",
    "mkdocstrings[python]>=0.28.0",
    "mkdocs-gen-files>=0.5.0",
    "whenever>=0.7.3,<1.0.0",
    # Need to stay in sync with otel extra
    "opentelemetry-distro>=0.48b0,<1.0.0",
    "opentelemetry-exporter-otlp>=1.27.0,<2.0.0",
    "opentelemetry-instrumentation>=0.48b0,<1.0.0",
    "opentelemetry-instrumentation-logging>=0.48b0,<1.0.0",
    "opentelemetry-instrumentation-system-metrics>=0.48b0,<1.0.0",
    "opentelemetry-test-utils>=0.48b0,<1.0.0",
]

perf = ["logfire[fastapi,sqlalchemy]>=3.14.0", "pyinstrument>=5.0.0"]

cli-bench = ["python-cli-bench @ git+https://github.com/zzstoatzz/python-cli-bench.git"]

markdown-docs = [
    "pytest-markdown-docs>=0.6.0",
    "prefect[aws]",
    "prefect[azure]",
    "prefect[bitbucket]",
    "prefect[dask]",
